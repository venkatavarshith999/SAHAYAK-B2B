# Database (PostgreSQL)
DATABASE_URL="postgresql://sahayak_user:strong_password@localhost:5432/sahayak_b2b?schema=public"

# Server & Security
PORT=4000
NODE_ENV="development"
FRONTEND_ORIGIN="http://localhost:3000"
SESSION_SECRET="replace-with-64-char-random-hex-secret"
CSRF_SECRET="replace-with-32-char-random-hex-secret"
SESSION_TTL_HOURS=24

# Google OAuth 2.0 / OpenID Connect
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# Google Gemini AI (@google/genai)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_RATE_LIMIT_PER_MIN=30
